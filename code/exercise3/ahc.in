--
&inputph
  prefix    = 'graphene'
  reduce_io = .true.
  fildyn    = 'graphene_ahc.dyn.xml'
  ldisp     = .true.
  fildvscf  = 'dvscf'
  nq1 = 6
  nq2 = 6
  nq3 = 1

  ! Input variables for Allen-Heine-Cardona calculation
  electron_phonon = 'ahc'
  trans           = .false.
  ahc_nbnd        = 12
  ahc_nbndskip    = 0
  ahc_dir         = './save/ahc_dir/'
 /
