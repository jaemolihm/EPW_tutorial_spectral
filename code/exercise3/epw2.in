--
&inputepw
  prefix      = 'mgb2'
  outdir      = './'
  dvscf_dir   = './save'
  etf_mem     =  1
  lopt_w2b    = .false.

  elph        = .true.
  use_ws      = .true.
  epwread     = .true.

  ! --- Input variables for phonon spectral function ---
  specfun_ph   = .true.

  filqf      = './qpt.txt'
  nkf1       = 10
  nkf2       = 10
  nkf3       = 10

  wmin_specfun = 0.00 ! eV
  wmax_specfun = 0.12 ! eV
  nw_specfun   = 200
  degaussw   = 0.05   ! eV
  temps      = 300.0  3157.75  ! Kelvin (0.02 Ry = 3157.75 K)
  ! ------------------------------------------------------

  nbndsub     =  5

  efermi_read  = .true.
  fermi_energy = 7.5014

  nk1         = 6
  nk2         = 6
  nk3         = 6

  nq1         = 3
  nq2         = 3
  nq3         = 2
/
