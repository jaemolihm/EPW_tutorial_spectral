--
&inputepw
  prefix      = 'graphene'
  outdir      = './'
  dvscf_dir   = './save'
  etf_mem     =  0
  lopt_w2b    = .true.

  elph        = .true.
  use_ws      = .true.
  epwread     = .true.

  ! --- Input variables for WFPT ---
  lwfpt       = .true.
  ahc_nbnd    = 12
  ahc_win_max = -1.0
  ahc_win_min = -6.5
  !ahc_rest_fan_broadening = 0.0d0

  ! --- Input variables for electron self-energy ---
  elecselfen = .true.
  filkf      = './kpt_near_K.txt'
  nqf1       = 240
  nqf2       = 240
  nqf3       = 1
  degaussw   = 0.005  ! eV
  temps      = 300.0 ! Kelvin

  ! --- Input variables for electron spectral function ---
  specfun_el   = .true.
  wmax_specfun =  1.0
  wmin_specfun = -1.0
  nw_specfun   = 200
  ! ------------------------------------------------------

  nbndsub     =  2

  efermi_read  = .true.
  fermi_energy = -2.5341

  nk1         = 12
  nk2         = 12
  nk3         = 1

  nq1         = 6
  nq2         = 6
  nq3         = 1
/
