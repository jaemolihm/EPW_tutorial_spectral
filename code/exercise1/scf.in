--
&control
   calculation  = 'scf'
   prefix       = 'diamond'
   pseudo_dir   = './'
   outdir       = './'
/
&system
   ibrav     = 2
   celldm(1) = 6.74
   nat       = 2
   ntyp      = 1
   ecutwfc   = 40.0
/
&electrons
   diagonalization = 'david'
   mixing_beta     = 0.7
   conv_thr        = 1.0d-13
/
ATOMIC_SPECIES
  C  12.011   C.pz-vbc.UPF
ATOMIC_POSITIONS crystal
  C  0.125   0.125   0.125
  C -0.125  -0.125  -0.125
K_POINTS automatic
 8 8 8 0 0 0

